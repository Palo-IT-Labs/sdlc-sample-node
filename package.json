{
  "name": "sdlc-sample-node",
  "version": "1.0.0",
  "description": "Application Node.js de démonstration pour éprouver le SDLC Blueprint sur une seconde stack",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "pretest": "node -e \"require('node:fs').mkdirSync('test-results',{recursive:true})\"",
    "test": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/junit.xml"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true
}
